generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CatalogStatus {
  active
  inactive
}

enum PromotionStatus {
  DRAFT
  PUBLISHED
  PAUSED
  EXPIRED
}

enum OrderStatus {
  PENDING_APPROVAL
  ACCEPTED
  PREPARING
  READY
  COMPLETED
  REJECTED
  CANCELLED
}

enum PrintJobStatus {
  PENDING
  CLAIMED
  PRINTING
  PRINTED
  FAILED
  UNCERTAIN
}

enum PrintDocumentType {
  PRODUCTION
  CUSTOMER
}

enum StaffRole {
  STAFF
  MANAGER
  ADMIN
}

model Branch {
  id        String   @id @db.Uuid
  name      String
  phone     String?
  address   String?
  hours     String?
  mapsUrl   String?  @map("maps_url")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("branches")
}

model Category {
  id        String        @id @db.Uuid
  name      String
  order     Int           @default(999)
  status    CatalogStatus @default(active)
  imageUrl  String?       @map("image_url")
  createdAt DateTime      @default(now()) @map("created_at")
  products  Product[]

  @@map("categories")
}

model Product {
  id                String        @id @db.Uuid
  name              String
  price             Decimal       @db.Decimal(10, 2)
  categoryId        String        @map("category_id") @db.Uuid
  category          Category      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  status            CatalogStatus @default(active)
  description       String?
  shortDescription  String?       @map("short_description")
  subcategory       String?
  imageUrl          String?       @map("image_url")
  order             Int           @default(999)
  isPromotion       Boolean       @default(false) @map("is_promotion")
  promotionTag      String?       @map("promotion_tag")
  promotionTagColor String?       @map("promotion_tag_color")
  createdAt         DateTime      @default(now()) @map("created_at")

  @@index([categoryId])
  @@index([categoryId, subcategory, order])
  @@index([status])
  @@map("products")
}

model Customer {
  id                String             @id @db.Uuid
  name              String
  phone             String             @unique
  password          String // Hash de contraseña
  points            Int                @default(0)
  favoriteBranchId  String?            @map("favorite_branch_id") @db.Uuid
  createdAt         DateTime           @default(now()) @map("created_at")
  sessions          Session[]
  orders            Order[]
  rewardRedemptions RewardRedemption[]

  @@map("customers")
}

model RedeemableProduct {
  id          String             @id @db.Uuid
  name        String
  pointsCost  Int                @map("points_cost")
  status      CatalogStatus      @default(active)
  imageUrl    String?            @map("image_url")
  description String?
  order       Int                @default(999)
  createdAt   DateTime           @default(now()) @map("created_at")
  redemptions RewardRedemption[]

  @@index([status])
  @@map("redeemable_products")
}

model RewardRedemption {
  id                  String            @id @db.Uuid
  customerId          String            @map("customer_id") @db.Uuid
  customer            Customer          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  redeemableProductId String            @map("redeemable_product_id") @db.Uuid
  redeemableProduct   RedeemableProduct @relation(fields: [redeemableProductId], references: [id], onDelete: Restrict)
  productName         String            @map("product_name")
  pointsCost          Int               @map("points_cost")
  createdAt           DateTime          @default(now()) @map("created_at")

  @@index([customerId])
  @@index([redeemableProductId])
  @@map("reward_redemptions")
}

model Session {
  id         String   @id @db.Uuid
  customerId String   @map("customer_id") @db.Uuid
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now()) @map("created_at")
  expiresAt  DateTime @map("expires_at")

  @@map("sessions")
}

model Order {
  id               String              @id @db.Uuid
  folio            String              @unique
  customerId       String?             @map("customer_id") @db.Uuid
  customer         Customer?           @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerName     String              @map("customer_name")
  customerPhone    String              @map("customer_phone")
  branchId         String              @map("branch_id") @db.Uuid
  branchName       String              @map("branch_name")
  status           OrderStatus         @default(PENDING_APPROVAL)
  rejectionReason  String?             @map("rejection_reason")
  // Customer-initiated cancellation request while ACCEPTED/PREPARING — the
  // branch must approve or reject it (status itself doesn't change until
  // then). Never set together with a terminal status.
  cancellationRequestedAt    DateTime? @map("cancellation_requested_at")
  cancellationRequestReason  String?   @map("cancellation_request_reason")
  total            Decimal             @db.Decimal(10, 2)
  // pointsEarned is calculated (and frozen) at creation time, but only
  // credited to the customer's balance when the order reaches COMPLETED
  // (delivered) — never on creation/acceptance/preparation. pointsCredited
  // guards against crediting the same order twice.
  pointsEarned     Int                 @default(0) @map("points_earned")
  pointsCredited   Boolean             @default(false) @map("points_credited")
  pointsRedeemed   Int                 @default(0) @map("points_redeemed")
  deliveryType     String              @map("delivery_type") // delivery, pickup
  paymentMethod    String              @map("payment_method") // cash, card
  notes            String?
  createdAt        DateTime            @default(now()) @map("created_at")
  items            OrderItem[]
  statusHistory    OrderStatusHistory[]
  printJobs        OrderPrintJob[]

  @@index([status])
  @@index([branchId, status])
  @@index([branchId, createdAt])
  @@index([customerId, createdAt])
  @@map("orders")
}

model OrderStatusHistory {
  id         String       @id @db.Uuid
  orderId    String       @map("order_id") @db.Uuid
  order      Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromStatus OrderStatus? @map("from_status")
  toStatus   OrderStatus  @map("to_status")
  staffId    String?      @map("staff_id") @db.Uuid
  staff      Staff?       @relation(fields: [staffId], references: [id], onDelete: SetNull)
  reason     String?
  metadata   Json?
  createdAt  DateTime     @default(now()) @map("created_at")

  @@index([orderId, createdAt])
  @@map("order_status_history")
}

model OrderPrintJob {
  id                     String            @id @db.Uuid
  orderId                String            @map("order_id") @db.Uuid
  order                  Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  branchId               String            @map("branch_id") @db.Uuid
  documentType           PrintDocumentType @default(PRODUCTION) @map("document_type")
  status                 PrintJobStatus    @default(PENDING)
  attempts               Int               @default(0)
  claimedByStationId     String?           @map("claimed_by_station_id") @db.Uuid
  claimedByStationName   String?           @map("claimed_by_station_name")
  claimedAt              DateTime?         @map("claimed_at")
  leaseExpiresAt         DateTime?         @map("lease_expires_at")
  nextAttemptAt          DateTime?         @map("next_attempt_at")
  printingStartedAt      DateTime?         @map("printing_started_at")
  printedAt              DateTime?         @map("printed_at")
  uncertainAt            DateTime?         @map("uncertain_at")
  lastError              String?           @map("last_error")
  lastResult             String?           @map("last_result")
  createdAt              DateTime          @default(now()) @map("created_at")
  updatedAt              DateTime          @updatedAt @map("updated_at")

  @@unique([orderId, documentType])
  @@index([branchId, status, createdAt])
  @@index([claimedByStationId, status])
  @@map("order_print_jobs")
}

model Staff {
  id            String               @id @db.Uuid
  name          String
  username      String               @unique
  password      String
  role          StaffRole            @default(STAFF)
  branchId      String?              @map("branch_id") @db.Uuid
  active        Boolean              @default(true)
  createdAt     DateTime             @default(now()) @map("created_at")
  sessions      StaffSession[]
  statusChanges OrderStatusHistory[]

  @@index([branchId])
  @@map("staff")
}

model StaffSession {
  id        String   @id @db.Uuid
  staffId   String   @map("staff_id") @db.Uuid
  staff     Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")
  expiresAt DateTime @map("expires_at")

  @@index([staffId])
  @@map("staff_sessions")
}

model OrderItem {
  id          String  @id @db.Uuid
  orderId     String  @map("order_id") @db.Uuid
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String  @map("product_id") @db.Uuid
  productName String  @map("product_name")
  price       Decimal @db.Decimal(10, 2)
  quantity    Int
  meatPrep    String? @map("meat_prep")
  extras      String? // JSON string representing extras: name, price
  removals    String? // Comma-separated or JSON list of removals

  @@map("order_items")
}

model HomeBanner {
  id         String   @id @db.Uuid
  imageUrl   String   @map("image_url")
  title      String?
  subtitle   String?
  buttonText String?  @map("button_text")
  linkView   String?  @map("link_view")
  order      Int      @default(999)
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("home_banners")
}

model Promotion {
  id          String          @id @db.Uuid
  title       String
  promoText   String          @map("promo_text")
  description String
  price       Decimal         @db.Decimal(10, 2)
  imageUrl    String          @map("image_url")
  status      PromotionStatus @default(DRAFT)
  publishedAt DateTime?       @map("published_at")
  expiresAt   DateTime?       @map("expires_at")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  @@index([status, expiresAt])
  @@index([publishedAt])
  @@map("promotions")
}

model SystemSetting {
  key   String @id
  value String

  @@map("system_settings")
}

model Feedback {
  id        String   @id @db.Uuid
  rating    Int
  comment   String
  createdAt DateTime @default(now()) @map("created_at")

  @@map("feedbacks")
}

model SurveyResponse {
  id                String   @id @default(uuid()) @db.Uuid
  branch            String
  ratingGeneral     Int      @map("rating_general")
  ratingFood        Int      @map("rating_food")
  ratingService     Int      @map("rating_service")
  ratingWaitTime    Int      @map("rating_wait_time")
  ratingCleanliness Int      @map("rating_cleanliness")
  wouldReturn       String   @map("would_return")
  comment           String?
  ipHash            String   @map("ip_hash")
  userAgent         String?  @map("user_agent")
  createdAt         DateTime @default(now()) @map("created_at")

  @@index([branch])
  @@index([createdAt])
  @@index([ratingGeneral])
  @@map("survey_responses")
}

model VisitCounter {
  id        String   @id
  count     Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("visit_counters")
}
